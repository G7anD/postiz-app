# syntax=docker/dockerfile:1
# Nashrchi build: same result as Dockerfile.dev, but dependencies are installed
# in their own layer before the source is copied. A code-only change then reuses
# the ~4 GB node_modules layer instead of reinstalling and re-exporting it.
FROM node:22.23.4-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

# 1. Dependencies: only the package manifests, so this layer is reused until a
#    dependency changes. Install scripts run after the source copy: pnpm 10 only
#    builds onlyBuiltDependencies (bcrypt), and the workspace postinstalls need
#    source files (prisma schema, frontend scripts).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc /app/
COPY apps/backend/package.json /app/apps/backend/
COPY apps/commands/package.json /app/apps/commands/
COPY apps/extension/package.json /app/apps/extension/
COPY apps/frontend/package.json /app/apps/frontend/
COPY apps/orchestrator/package.json /app/apps/orchestrator/
COPY apps/sdk/package.json /app/apps/sdk/
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --ignore-scripts && pnpm rebuild bcrypt

# 2. Source, the skipped workspace postinstalls, and the build.
COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
RUN pnpm run postinstall && pnpm --filter ./apps/frontend run postinstall
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
